{
    "manifest_version": 3,
    "name": "remllm",
    "version": "1.0.5",
    "description": "Let's go back to the days before LLMs!",
    "permissions": [
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": ["https://*.google.com/*"],
            "css": ["google/hide.css"],
            "js": ["google/remove.js"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://*.google.com/search*"],
            "css": ["google/search/hide.css"],
            "js": ["google/search/remove.js"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://drive.google.com/*"],
            "css": ["google/drive/hide.css"],
            "js": ["google/drive/remove.js"],
            "run_at": "document_start"
        }
    ],
    "declarative_net_request": {
        "rule_resources": [{
            "id": "ruleset",
            "enabled": true,
            "path": "rules.json"
        }]
    }
}