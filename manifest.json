{
    "manifest_version": 3,
    "name": "remllm",
    "version": "1.0.1",
    "description": "Let's go back to the days before LLMs!",
    "permissions": [
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [{
        "matches": ["https://*.google.com/search*"],
        "css": ["hide.css"],
        "js": ["remove.js"],
        "run_at": "document_start"
    }],
    "declarative_net_request": {
        "rule_resources": [{
            "id": "ruleset_1",
            "enabled": true,
            "path": "rules.json"
        }]
    }
}